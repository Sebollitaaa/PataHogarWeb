# ---- Servidor ----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ---- Base de datos MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=patahogar
DB_USER=patahogar_app
DB_PASSWORD=

# ---- JWT ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS_REMEMBER=30
JWT_REFRESH_EXPIRES_IN_DAYS_SESSION=1

# ---- Seguridad ----
LOCATION_MISMATCH_BLOCK_KM=100

# ---- Correo (verificación de email y recuperación de contraseña) ----
# Resend (https://resend.com): requiere un dominio verificado para enviar a cualquier destinatario.
# Sin RESEND_API_KEY y fuera de producción, los correos se simulan y el código se imprime en la consola del backend.
RESEND_API_KEY=
EMAIL_FROM="PataHogar <no-reply@tu-dominio.com>"
EMAIL_CODE_EXPIRES_MIN=15
EMAIL_RESEND_COOLDOWN_SECONDS=60

# ---- Notificaciones push (Web Push) ----
# Generar el par de claves una sola vez:  npx web-push generate-vapid-keys
# Sin claves, las notificaciones push quedan desactivadas (el resto del sistema funciona igual).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://patahogar.online
EMAIL_CODE_MAX_ATTEMPTS=5
